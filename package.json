{
  "name": "agentic-ai-server",
  "version": "1.0.0",
  "description": "TCS Agentic AI — OpenShift Intelligence Platform with MCP Hub, multi-server orchestration, and enterprise integrations",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/unit/*.test.js",
    "evals": "node test/evals/run-evals.js",
    "test:smoke": "node test/smoke/mcp-smoke-test.mjs",
    "build:dashboard": "npm --prefix console ci && npm --prefix console run build",
    "lint": "node --test test/unit/no-undefined-calls.test.js",
    "bench:models": "node test/evals/model-bench.mjs",
    "docs:agents": "PUBLIC_BASE_URL=${PUBLIC_BASE_URL:-https://mcp-dashboard-openshift-mcp.apps.openshift.caaslab.local} node docs/generate-agent-catalog.js",
    "docs:agents:xlsx": "PUBLIC_BASE_URL=${PUBLIC_BASE_URL:-https://mcp-dashboard-openshift-mcp.apps.openshift.caaslab.local} node docs/generate-agent-catalog-excel.cjs",
    "docs:agents:all": "npm run docs:agents && npm run docs:agents:xlsx"
  },
  "keywords": [
    "mcp",
    "openshift",
    "kubernetes",
    "servicenow",
    "ansible"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "docx": "^9.7.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "undici": "^6.21.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "canvas": "^3.2.3",
    "exceljs": "^4.4.0",
    "pptxgenjs": "^4.0.1",
    "xlsx": "^0.18.5"
  }
}
