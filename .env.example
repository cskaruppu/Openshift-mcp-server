# OpenShift Configuration
OPENSHIFT_API_URL=https://api.your-cluster.example.com:6443
OPENSHIFT_TOKEN=your-openshift-token
# Or use kubeconfig
KUBECONFIG=/path/to/kubeconfig

# ServiceNow Configuration
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-password
# Or use OAuth
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# Ansible Automation Platform Configuration
ANSIBLE_CONTROLLER_URL=https://ansible-controller.apps.your-cluster.example.com
ANSIBLE_CONTROLLER_TOKEN=your-ansible-token

# MCP Server Configuration
MCP_SERVER_PORT=3000
MCP_TRANSPORT=stdio
LOG_LEVEL=info

# Emergency Configuration
EMERGENCY_AUTO_FIX=false
EMERGENCY_NOTIFICATION_WEBHOOK=https://your-webhook-url

# Access Control — tiered access levels
# readonly  — read-only operations only (get, describe, logs, top, etc.)
# readwrite — read + mutating operations (create, patch, scale, etc.)
# admin     — all operations (default when not set)
# ACCESS_LEVEL=admin

# Component Toggles — selectively enable/disable tool categories
# Comma-separated. Available: core, observability, security, networking, itsm, lifecycle, upgrade, advanced
# Set to "all" or leave unset to enable everything (default behavior).
# ENABLED_COMPONENTS=all

# Namespace Restrictions — restrict operations to specific namespaces
# Comma-separated list. Leave unset to allow all namespaces.
# ALLOWED_NAMESPACES=default,my-app,staging

# OpenTelemetry — distributed tracing and metrics export
# Set OTLP_ENDPOINT to enable. Compatible with Jaeger, Grafana Tempo, Datadog, Dynatrace, etc.
# OTLP_ENDPOINT=http://jaeger-collector:4318
# OTLP_HEADERS=Authorization=Bearer your-token
# OTEL_SERVICE_NAME=tcs-agentic-ai

# LLM Configuration for Dashboard AI Chat
# Provider: "openai", "anthropic", "ollama", or "none" (built-in analysis)
LLM_PROVIDER=none
# LLM_API_URL=https://api.openai.com
# LLM_API_KEY=your-api-key
# LLM_MODEL=gpt-4
# For Ollama: LLM_PROVIDER=ollama, LLM_API_URL=http://ollama.your-namespace:11434, LLM_MODEL=llama3
# For Anthropic Claude (highest accuracy — recommended for production):
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#   LLM_MODEL=claude-opus-4-7              # most accurate (recommended)
#   LLM_MODEL=claude-sonnet-4-6            # balanced cost/accuracy
#   LLM_MODEL=claude-haiku-4-5-20251001    # fastest, lower cost

# ── Metrics (Prometheus / Thanos) ─────────────────────────────────────────
# Thanos uses an OpenShift service-serving certificate, signed by the
# service-ca operator rather than the kube root CA. The deployment mounts that
# bundle at /etc/service-ca/service-ca.crt and it is trusted automatically.
#
# A REMOTE cluster is reached over its Route, which presents that cluster's
# ingress certificate. Point PROMETHEUS_CA_FILE at it, or in a lab:
# PROMETHEUS_CA_FILE=/etc/remote-ca/ingress-ca.crt
# PROMETHEUS_INSECURE=false      # true disables TLS verification for metrics only
# PROMETHEUS_URL=                # override the local endpoint

# ── Self-hosted LLM (vLLM on your own GPUs) ───────────────────────────────
# vLLM speaks the OpenAI API, so no code changes are needed — the openai
# provider already builds its URL from LLM_API_URL and supports tool calling.
# See deploy/vllm/README.md.
# LLM_PROVIDER=openai
# LLM_API_URL=https://vllm-llm-serving.apps.<cluster-domain>
# LLM_MODEL=llama-3.3-70b-instruct
# LLM_API_KEY=<contents of the vllm-api-key secret>

# ── Public base URL ───────────────────────────────────────────────────────
# The externally reachable route for this hub. Used when generating the agent
# catalog so the documented endpoints are ones an integrator can actually call.
PUBLIC_BASE_URL=https://mcp-dashboard-openshift-mcp.apps.openshift.caaslab.local
