# OpenShift Configuration
OPENSHIFT_API_URL=https://api.your-cluster.example.com:6443
OPENSHIFT_TOKEN=your-openshift-token
# Or use kubeconfig
KUBECONFIG=/path/to/kubeconfig

# ServiceNow Configuration
SERVICENOW_INSTANCE=https://your-instance.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your-password
# Or use OAuth
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# Ansible Automation Platform Configuration
ANSIBLE_CONTROLLER_URL=https://ansible-controller.apps.your-cluster.example.com
ANSIBLE_CONTROLLER_TOKEN=your-ansible-token

# MCP Server Configuration
MCP_SERVER_PORT=3000
MCP_TRANSPORT=stdio
LOG_LEVEL=info

# Emergency Configuration
EMERGENCY_AUTO_FIX=false
EMERGENCY_NOTIFICATION_WEBHOOK=https://your-webhook-url
